<Window x:Class="SystemConfigWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Configuration Wizard" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Main Content -->
        <Viewbox Stretch="Uniform">
            <Grid Width="600" Height="400" Margin="20">

                <!-- Step 1: System Version -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Step 1: Select System Version" FontSize="24" Margin="0,0,0,20" TextAlignment="Center"/>
                    <ComboBox x:Name="VersionComboBox" Width="200" FontSize="18" Margin="0,0,0,20">
                        <ComboBoxItem Content="Version 7" IsSelected="True"/>
                        <ComboBoxItem Content="Version 10"/>
                        <ComboBoxItem Content="Version 11"/>
                    </ComboBox>
                    <Button Content="Далее" Width="120" Height="40" FontSize="18" Click="Step1Next_Click"/>
                </StackPanel>

                <!-- Step 2: Environment Tier -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Step 2: Select Environment Tier" FontSize="24" Margin="0,0,0,20" TextAlignment="Center"/>
                    <ComboBox x:Name="TierComboBox" Width="200" FontSize="18" Margin="0,0,0,20">
                        <ComboBoxItem Content="Home" IsSelected="True"/>
                        <ComboBoxItem Content="Pro"/>
                    </ComboBox>
                    <Button Content="Далее" Width="120" Height="40" FontSize="18" Click="Step2Next_Click"/>
                </StackPanel>

                <!-- Step 3: Run -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Step 3: Ready to Validate" FontSize="24" Margin="0,0,0,20" TextAlignment="Center"/>
                    <Button Content="Запустить" Width="150" Height="50" FontSize="20" FontWeight="Bold" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- Centered Overlay for Status Messages -->
        <Border x:Name="OverlayBorder" Visibility="Collapsed" Background="#CC000000">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="20"/>
        </Border>
    </Grid>
</Window>